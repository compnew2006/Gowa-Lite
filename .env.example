# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional gowa gateway connection defaults (can also be configured in Setup/Settings UI)
GOWA_URL=
GOWA_USERNAME=
GOWA_PASSWORD=

# Optional HMAC signing secret for reaction webhooks at POST /api/webhooks/gowa
# Use the same value for WHATSAPP_WEBHOOK_SECRET on the GOWA gateway.
GOWA_WEBHOOK_SECRET=

# Optional override passcode for initial admin bootstrap
ADMIN_PASSCODE=

# Optional SQLite database file path (defaults to ./gowa-lite.db)
GOWA_LITE_DB_PATH=

# Optional master secret to encrypt GOWA credentials stored in SQLite (auto-generates <db>.key if omitted)
GOWA_SETTINGS_SECRET=

# Express trust proxy setting ("false", "true", hop count like "1", or CIDR/preset)
TRUST_PROXY=false

# Set to "true" to block private/loopback RFC1918 GOWA_URL targets in addition to cloud metadata endpoints
BLOCK_PRIVATE_GOWA_URL=false

# Set to "false" to disable HTTP gzip compression middleware
ENABLE_COMPRESSION=true

# Set to "true" only if upstream GOWA WS proxy requires ?authorization= query param
GOWA_WS_QUERY_AUTH=false
