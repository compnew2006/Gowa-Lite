# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional gowa gateway connection defaults (can also be configured in Setup/Settings UI)
GOWA_URL=
GOWA_USERNAME=
GOWA_PASSWORD=

# Optional override passcode for initial admin bootstrap
ADMIN_PASSCODE=

# Optional SQLite database file path (defaults to ./gowa-lite.db)
GOWA_LITE_DB_PATH=
